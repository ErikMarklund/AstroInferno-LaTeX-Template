% The colour used in \AISetThemeColour when a new colour is not set
\colorlet {themecolour} {AIlightteal}

% Sets the themecolour and colours for all themed elements
% If called without the optional colour, resets the colour of all themed elements to the current themecolour
\NewDocumentCommand {\AISetThemeColour} { O {themecolour} }
  {
    \colorlet {themecolour}   {#1}
    \colorlet {commentcolour} {#1}
    \colorlet {sidebarcolour} {#1}
    \colorlet {tablecolour}   {#1}
  }

\DeclareRobustCommand{\normalcolor}{\color{AIcurrentcolour}}
