\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Environment for read-aloud text.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Standard for every read-aloud text
\DeclareTColorBox {__AI_read_aloud} {o}
  {
    before~upper    =
      {
        \bool_if:NT \l__AI_layout_bool
          {
            \bool_if:NF \l__AI_justified_bool
              {\RaggedRight}
          }
      },
    code            = {\linespread {1.1} },
    enhanced~jigsaw,
    frame~hidden,
    boxrule         = 0pt,
    breakable,
    enhanced,
    before~skip     = 13pt plus 4pt minus 4pt,
    boxsep          = 8pt,
    top             = 0pt,
    left            = 0pt,
    right           = 0pt,
    bottom          = 0pt,
    sharp~corners,
    parbox          = false,
    fontupper       = \AIFontReadAloud,
    fontlower       = \AIFontReadAloud,
    after~skip      = 13pt plus 4pt minus 4pt,
    #1,
  }

% Extra key for controlling the color of the title and the background
\keys_define:nn { astroinferno / read_aloud }
  {
    color .tl_set:N         = \l__AI_read_aloud_color_tl,
    color .initial:n        = readaloudcolor,
    color .value_required:n = true,
  }

% This function, through its variant, forces the expansion of the tcb keys
% passed to the environment by the user before it invokes the tcolorbox
\cs_new_protected:Nn \__AI_start_read_aloud:nn
  {
    \begin {__AI_read_aloud} [ #1, #2 ]
  }

\cs_generate_variant:Nn \__AI_start_read_aloud:nn { nV }

% The AIReadAloud environment
% #1 - keys. We handle the custom color key before passing other keys on
\NewDocumentEnvironment {AIReadAloud} {o}
	{
      		\group_begin:
      		\tl_clear:N \l_tmpa_tl
      		\tl_if_novalue:nF {#1}
        		{ \keys_set_known:nnN { astroinferno / read_aloud } {#1} \l_tmpa_tl }

      		\__AI_start_read_aloud:nV
        		{ colback = \l__AI_read_aloud_color_tl, }
        	\l_tmpa_tl
    	}
{
    \end {__AI_read_aloud}
    \group_end:
  }
