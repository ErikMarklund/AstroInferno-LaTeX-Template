\ExplSyntaxOn


% Adds a boxstyle to readalouds
\NewDocumentCommand\AIReadAloudAddBoxstyle{m}
{ \tcbset{ AI_readaloud_extra/.append~style={#1} } }

% Clears all boxstyles from readalouds
\NewDocumentCommand\AIReadAloudClearBoxstyle{}
{ \tcbset{ AI_readaloud_extra/.style={} } }

% Revert to dafault. Readalouds use a plain style.
\NewDocumentCommand\AIReadAloudDefaultBoxstyle{}
{ \AIReadAloudClearBoxstyle }

% Initialise
\AIReadAloudDefaultBoxstyle

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Environment for read-aloud text.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Make a comment base style
\tcbset{
  AI_readaloud_base/.style = {
    before~upper    =
    {
      \bool_if:NT \l__AI_layout_bool
      {
        \bool_if:NF \l__AI_justified_bool
        {\RaggedRight}
      }
    },
    code            = {\linespread {1.1} },
    enhanced~jigsaw,
    frame~hidden,
    boxrule         = 0pt,
    breakable,
    enhanced,
    before~skip     = 13pt plus 4pt minus 4pt,
    boxsep          = 8pt,
    top             = 0pt,
    left            = 0pt,
    right           = 0pt,
    bottom          = 0pt,
    sharp~corners,
    parbox          = false,
    fontupper       = \AIFontReadAloud,
    fontlower       = \AIFontReadAloud,
    after~skip      = 13pt plus 4pt minus 4pt,
  }
}

% Standard for every read-aloud text
\DeclareTColorBox {__AI_read_aloud} {o}
  {
    AI_readaloud_base,
    AI_readaloud_extra,
    #1,
  }

% Extra key for controlling the colour of the title and the background
\keys_define:nn { astroinferno / read_aloud }
  {
    colour .tl_set:N         = \l__AI_read_aloud_colour_tl,
    colour .initial:n        = readaloudcolour,
    colour .value_required:n = true,
  }

% This function, through its variant, forces the expansion of the tcb keys
% passed to the environment by the user before it invokes the tcolorbox
\cs_new_protected:Nn \__AI_start_read_aloud:nn
  {
    \begin {__AI_read_aloud} [ #1, #2 ]
  }

\cs_generate_variant:Nn \__AI_start_read_aloud:nn { nV }

% The AIReadAloud environment
% #1 - keys. We handle the custom colour key before passing other keys on
\NewDocumentEnvironment {AIReadAloud} {o}
	{
      		\group_begin:
      		\tl_clear:N \l_tmpa_tl
      		\tl_if_novalue:nF {#1}
        		{ \keys_set_known:nnN { astroinferno / read_aloud } {#1} \l_tmpa_tl }

      		\__AI_start_read_aloud:nV
        		{ colback = \l__AI_read_aloud_colour_tl, }
        	\l_tmpa_tl
    	}
{
    \end {__AI_read_aloud}
    \group_end:
  }
