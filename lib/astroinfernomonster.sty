\ExplSyntaxOn

\tl_new:N \l_monster_global_style_tl

\NewDocumentCommand{\AIMonsterStyle} {m}
{
  \tl_set:Nn \l_monster_global_style_tl {#1}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Monster environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\keys_define:nn { astroinferno / monster / monsterdata }
{
  % We want this to set up the font for the title.
  name .tl_set:N  = \l_monster_name_tl,
  name .initial:n  = -~unknown~-,
  name .value_required:n = true,
  % titlepreamble is code inserted at the start of the title.
  % For example, \rule{0pt}{1cm} to insert a strut to regulate effective height,
  % which is useful for alignment of side-by-side adversaries with different
  % title fonts.
  titlepreamble .tl_set:N  = \l_monster_title_preamble_tl,
  titlepreamble .initial:n  = {},
  titlepreamble .value_required:n = true,
  titlefont .tl_set:N =\l_monster_titlefont_tl,
  titlefont .initial:n   = \l__AI_stat_block_title_family_tl,
  titlestyle .tl_set:N = \l_monster_titlestyle_tl,
  titlestyle .initial:n = \l__AI_stat_block_title_style_tl,
  titleheight .tl_set:N  = \l_monster_titleheight_tl,
  titleheight .initial:n  = -1pt, % if -1, use 1ex
  titleheight .value_required:n = true,
  % titlealign is used for the third optional argument (internal alignment) in a parbox around the monster name
  titlealign .tl_set:N  = \l_monster_titlealign_tl,
  titlealign .initial:n  = t,
  titlealign .value_required:n = true,
  % Choose between katm, core. Will determine how troubles are rendered.
  monsterstyle .tl_set:N = \l_monster_style_tl,
  monsterstyle .initial:n  = {},
  monsterstyle .value_required:n  = true,
  %
  type .tl_set:N  = \l_monster_type_tl,
  type .initial:n  = -~unknown~-,
  type .value_required:n  = true,
  class .tl_set:N  = \l_monster_class_tl,
  class .initial:n  = -~unknown~-,
  class .value_required:n  = true,
  being .tl_set:N  = \l_monster_being_tl,
  being .initial:n  = -~unknown~-,
  being .value_required:n  = true,
  damage .tl_set:N  = \l_monster_damage_tl,
  damage .initial:n  = 0,
  damage .value_required:n  = true,
  mortality .tl_set:N  = \l_monster_mortality_tl,
  mortality .initial:n  = 0,
  mortality .value_required:n  = true,
  bones .tl_set:N  = \l_monster_bones_tl,
  bones .initial:n  = 0,
  bones .value_required:n  = true,
  quantity .tl_set:N  = \l_monster_quantity_tl,
  quantity .initial:n  = {},
  quantity .value_required:n  = true,
  % Troubles and endtroubles should be semicolon-separated lists,
  % because they need to accept commas in the items.
  % Each item should be a >-separated list:
  %   katm: action > description > mechanics
  %   core: action > combined description/mechanics
  troubles .tl_set:N  = \l_monster_troubles_tl,
  troubles .initial:n  = {},
  troubles .value_required:n  = true,
  % See troubles above. Here:
  %   katm: Action > narrative > description > mechanics
  %   cofre: Action > combined
  endtroubles .tl_set:N  = \l_monster_end_troubles_tl,
  endtroubles .initial:n  = {},
  endtroubles .value_required:n  = true,
  % See troubles above. Here:
  % katm: weakness > mechanics
  % core: weakness > mechanics (not present in core rulebook)
  weakness .tl_set:N  = \l_monster_weakness_tl,
  weakness .initial:n  = {},
  weakness .value_required:n  = true,
  traits .tl_set:N  = \l_monster_traits_tl,
  traits .initial:n  = -~unknown~-,
  traits .value_required:n  = true,
  description .tl_set:N  = \l_monster_description_tl,
  description .initial:n  = -~unknown~-,
  description .value_required:n  = true,
  % See troubles above. Here:
  %   Symbol > item > quantity
  harvest .tl_set:N = \l_monster_harvest_tl,
  harvest .initial:n  = {},
  harvest .value_required:n  = true,
  harvestchoose .tl_set:N = \l_monster_harvestchoose_tl,
  harvestchoose .initial:n  = one,
  harvestchoose .value_required:n  = true,
  % Extra space under endtroubles/weakness box. katm only.
  harvestgap .tl_set:N = \l_monster_harvestgap_tl,
  harvestgap .initial:n  = {0.2cm},
  harvestgap .value_required:n  = true,
  lootqty .tl_set:N  = \l_monster_lootqty_tl,
  lootqty .initial:n  = {0},
  lootqty .value_required:n  = true,
  lootblood .tl_set:N  = \l_monster_lootblood_tl,
  lootblood .initial:n  = -~unknown~-,
  lootblood .value_required:n  = true  
}

