\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Monster environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Simple stat block to mimic Astro Inferno adversary blocks in the rulebook
\DeclareTColorBox {AIMonster} { O{} m }
  {
    enhanced,
    frame~hidden,
    boxrule     = 0pt,
    breakable,
    parbox      = false,
    boxsep      = 0pt,
    toptitle    = 3mm,
    left        = 0pt,
    right       = 0pt,
    sharp~corners,
    opacityback = 0,
    %colframe    = titlered,
    fonttitle   = \AIFontStatBlockTitle,
    fontupper   = \AIFontStatBlockBody,
    fontlower   = \AIFontStatBlockBody,
    title            = {\hfill #2 \hfill\null},
    coltitle    = .,
    #1
  }

% Italicized text appearing immediately after monster's name
\NewDocumentCommand {\AIMonsterType} {m}
  {
    \hfill\MakeUppercase{\textbf {\scriptsize{#1}}}\hfill\null\\[1.5em]
  }

\NewDocumentCommand {\AIMonsterClass} {m}
  {
      \hfill\textls[300]{\MakeUppercase{\textbf{\large{#1}}}}\hfill\null\\[0.3em]
  }

\NewDocumentCommand{\AIMonsterBeing} {m}
  {
    \hfill\textls[60]{\MakeUppercase{\textbf {\large{#1}}}}\hfill\null\\
  }

% A description variant used to list creature attributes.
\newlist {__AI_monster_attributes} {description} {1}
\setlist [__AI_monster_attributes]
  {
    before   = \color {titlered},
    font     = \AIFontStatBlockBody,
    labelsep = \l__AI_space_dim,
    nosep,
  }

% Only prints the item label if the value was supplied
\cs_new_protected_nopar:Npn \__AI_if_monster_attribute:nn #1#2
  {
    \tl_if_empty:NF {#1}
      { \item [#2] #1 }
  }

%% Monster basics
\keys_define:nn { astroinferno / monster / basics }
  {
    % Not used in current code path and unlikely to be
    % resurrected. Mark for deletion.
    damage .tl_set:N   = \l__damage_tl,
    damage .initial:n   = 1,
    damage .value_required:n   = true,
    mortality .tl_set:N   = \l__mortality_tl,
    mortality .initial:n   = 20,
    mortality .value_required:n   = true,
    bones .tl_set:N   = \l__bones_tl,
    bones .initial:n   = 1,
    bones .value_required:n   = true,
  }

\NewDocumentCommand {\AIMonsterBasics} {m m m}
{
      \hfill
      {#1}\hspace{0.5em}\AIdamagesymbol\hspace{2em}
      {#2}\hspace{0.5em}\AImortalitysymbol\hspace{2em}
      {#3}\hspace{0.5em}\AIbonessymbol\hfill\null\\
  }

\NewDocumentCommand {\AIMonsterTroubles} {m m}
{
  \noindent
  \small
  \begin{minipage}[t]{0.49\columnwidth}
    \textbf{\textls[200]{\footnotesize TROUBLES}}\\
    \it
    % Map through the list and add a newline after each item
    \clist_map_inline:nn { #1 } { ##1 \\ }
  \end{minipage}
  \hfill
  \begin{minipage}[t]{0.49\columnwidth}
    \raggedleft
    \textbf{\textls[200]{\footnotesize END~TROUBLE}}\\
    \it
    % Map through the list and add a newline after each item
    \clist_map_inline:nn { #2 } { ##1 \\ }
  \end{minipage}\\

  \vspace{\baselineskip} % Add vertical space after the lists
}

\NewDocumentCommand {\AIMonsterTraits} {m}
{
  \hfill\MakeUppercase{\textbf {\scriptsize{#1}}}\hfill\null\\[0.4em]
}

\NewDocumentCommand {\AIMonsterDescription} {m}
{
  \noindent
  {\small{#1}\\[0.4em]}
}

% Optional argument gives number of choices from harvest table.
% m1 is pairs of harvest table entries {{h1, ammount1}, {h2, ammount2}, ... }
% m2 is loot and blood.
\NewDocumentCommand {\AIMonsterHarvest} {O{one} m m}
{
  \noindent
  \small
  % 1. Split the left side by commas into individual pairs
  \seq_set_split:Nnn \l_left_pairs_seq { , } { #2 }
  % 2. Split the right side by commas normally
  \seq_set_split:Nnn \l_right_list_seq { , } { #3 }

  % Left Column
  \begin{minipage}[t]{0.60\textwidth}
    \raggedright
    \textbf{Harvesting}~{\scriptsize(Choose~{#1})}\\
    % Loop through each pair element
    \seq_map_inline:Nn \l_left_pairs_seq 
     {
      % Split the single pair string using "/" as the internal divider
      \seq_set_split:Nnn \l_single_pair_seq { , } { ##1 }
      
      % Print item 1, push to the right edge, print item 2, start new line
      \textbf{\seq_item:Nn \l_single_pair_seq { 1 }}
      \hfill 
      \seq_item:Nn \l_single_pair_seq { 2 } \\
    }
  \end{minipage}
  \hfill
  
  % Right Column
  \begin{minipage}[t]{0.38\columnwidth}
    \raggedleft
    \textbf{Looting}\\
    % Map through the list and add a newline after each item
    \seq_map_inline:Nn \l_right_list_seq { ##1 \\ }
  \end{minipage}
  
  \vspace{\baselineskip} % Add vertical space after the lists
}
