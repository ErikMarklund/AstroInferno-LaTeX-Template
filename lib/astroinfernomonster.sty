\dim_new:N \l_theheight_dim

\NewDocumentCommand{\AIMonsterData} {O{}}
{
  \keys_set:nn { astroinferno / monster / monsterdata } {#1}

  % Use global value if monsterstyle option not set
  \tl_if_empty:NT \l_monster_style_tl
  { \tl_set:NV \l_monster_style_tl \l_monster_global_style_tl }
  
  % Print name
  % Is titleheight set? If >=0 then yes.
  \dim_compare:nTF {\l_monster_titleheight_tl < 0pt}
  { \dim_set:Nn \l_theheight_dim {1ex} } % Set to 1ex
  { \dim_set:Nn \l_theheight_dim {\l_monster_titleheight_tl} } % Set to titleheight

  { \l_monster_titlefont_tl \l_monster_titlestyle_tl \selectfont
    \parbox[t][\l_theheight_dim][\l_monster_titlealign_tl]{\columnwidth} {
      \hfill \l_monster_title_preamble_tl \l_monster_name_tl \hfill\null
    }\\[2mm]
  }
  \hfill\MakeUppercase{\textbf {\scriptsize{\l_monster_type_tl}}}\hfill\null\\[1.4em]
  \hfill\textls[350]{\MakeUppercase{{\fontsize{10}{12}\latoblack{\l_monster_class_tl}}}}\hfill\null\\[0.3em]
  \hfill\textls[180]{\MakeUppercase{{\fontsize{10}{12}\latoblack{\l_monster_being_tl}}}}\hfill\null\\[0.2mm]
  % Damage, mortality, bones
  \hfill
  \AIdamage{\l_monster_damage_tl}\hspace{2em}
  \AImortality{\l_monster_mortality_tl}\hspace{2em}
  \AIbones{\l_monster_bones_tl}
  \hfill\null\\[0.6em]
  \tl_if_eq:VnF {\l_monster_quantity_tl} {}
  {\hfill\MakeUppercase{\textbf {\scriptsize{\l_monster_quantity_tl}}}\hfill\null\\[0.3em]}
  % katm does traits before troubles
  \tl_if_eq:VnT {\l_monster_style_tl} {katm}
  {\hfill\MakeUppercase{\textbf {\scriptsize{\l_monster_traits_tl}}}\hfill\null\\[0.8em]}
  % Troubles
  \AIMonsterTroubles{\l_monster_troubles_tl}{\l_monster_end_troubles_tl}{\l_monster_weakness_tl}
  % core does traits here instead
  \tl_if_eq:VnF {\l_monster_style_tl} {katm}
  {\hfill\MakeUppercase{\textbf {\scriptsize{\l_monster_traits_tl}}}\hfill\null\\[0.4em]}
  {\small{\l_monster_description_tl}\\[1em]}
  % Harvest and loot.
  % Only write if not empty harvest list.
  % Leave empty if making separate harvest/loot box later.
  \tl_if_empty:NF \l_monster_harvest_tl
  {
    \AIMonsterHarvest[#1] {}
    %{\l_monster_harvest_tl}{\l_monster_lootqty_tl}{\l_monster_lootblood_tl}
  }
  \vspace{\baselineskip} % Add vertical space after the harvest/loot
}


% Used for setting how much the box extends outside column margins
\dim_new:N \l__katm_extend_dim

\NewDocumentCommand{\__put_in_katm_box} { O{} +m }
{
  \dim_set:Nn \l__katm_extend_dim {0.35cm}
  \begin{tcolorbox}[
    enhanced~jigsaw, 
    unbreakable,
    parbox       = false, 
    arc = 0.2cm,
    arc~is~angular,
    left~skip = -\l__katm_extend_dim,   % extend a bit to the sides of the column
    right~skip = -\l__katm_extend_dim,
    boxrule      = 0.5pt,
    titlerule      = 0pt,
    beforeafter~skip  = 0.135cm,
    toptitle     = 2pt,
    bottomtitle = 2pt,
    boxsep       = 3pt,
    left         = 6pt,
    right        = 6pt,
    top          = 0pt,
    bottom       = 6pt,
    fonttitle = \fontsize{16}{14} \AIfontMuara,
    %fontupper    = \normalsize \normalfont,
    %fontlower    = \normalsize \normalfont,
    center~title,
    colframe  = AIkatmboxtext,
    coltitle     = AIkatmboxtext,
    colback    = AIkatmboxtransp,
    colbacktitle    = AIkatmboxtransp,
    coltext = AIwhite,
    opacityfill = 0.8, % deduced from katm pdf
    opacitytext = 1,
    opacityframe = 1,
    #1
    ]
    {#2}
  \end{tcolorbox}
}

% Used by the internal (end)trouble rendering functions.
\tl_new:N \l__trouble_narrative_tl
\tl_new:N \l__trouble_description_tl
\tl_new:N \l__trouble_mechanics_tl

% Render (end)troubles core rulebook style
\NewDocumentCommand{\__core_troubles}{ m m m }
{
    % Here, we make two minipages that side by side,
    % but each wider than half a column, separated by
    % a negative space. Why? Because this can allow some
    % (end)troubles to be longer than half a line without
    % linebreaks. The downside is that the texts might overlap.
    % If that happens, fix manually by reordering the (end)troubles
    % or inserting manual linebreaks where needed.
    % Other solutions are\ possible, but this should work most
    % of the time and is simple.
  \small
  \begin{minipage}[t]{0.7\columnwidth}
    {\latoblack \textls[200]{\scriptsize TROUBLES}}\\
    \it
    \AINestedUnroll{#1} {
      \AIUnrolled{\l__trouble_mechanics_tl}{2}
      \AIUnrolledE{1}  % Action
      \tl_if_empty:NF \l__trouble_mechanics_tl {:~\l__trouble_mechanics_tl}\\
    }

  \end{minipage}
  \hspace{-0.61\columnwidth}
  \hfill
  \begin{minipage}[t]{0.7\columnwidth}
    \raggedleft
    {\latoblack \textls[200]{\scriptsize END~TROUBLE}}\\
    \it
    \AINestedUnroll{#2} {
      \AIUnrolled{\l__trouble_mechanics_tl}{2}
      \AIUnrolledE{1}  % Action
      \tl_if_empty:NF \l__trouble_mechanics_tl {:~\l__trouble_mechanics_tl}\\
    }
  \end{minipage}\\


  \tl_if_eq:VnF {\l_monster_weakness_tl} {}
  {
    \vspace{0.3cm}
    \begin{minipage}[]{\columnwidth}
      {\latoblack \textls[200]{\scriptsize WEAKNESS}}\\
      \it
      \AINestedUnroll{#3} {
        \AIUnrolled{\l__trouble_mechanics_tl}{2}
        \textbf{\AIUnrolledE{1}}  % Action
        \tl_if_empty:NF \l__trouble_mechanics_tl {\textbf{:}~\l__trouble_mechanics_tl}\\
      }
    \end{minipage}\\
  }

 \vspace{\baselineskip} % Add vertical space after the lists
}

% Render (end)troubles Key and the Machine style
\NewDocumentCommand{\__katm_troubles}{ m m m }
{
  % Troubles
  \__put_in_katm_box[title = Trouble]
  {
    \small
    \begin{itemize}
      \AINestedUnroll{#1} {
        \AIUnrolled{\l__trouble_description_tl}{2}
        \AIUnrolled{\l__trouble_mechanics_tl}{3}
      \item {\bfseries \AIUnrolledE{1} :}  % Action
        \tl_if_empty:NF \l__trouble_description_tl {~\l__trouble_description_tl}
        \tl_if_empty:NF \l__trouble_mechanics_tl {~\mbox{(\l__trouble_mechanics_tl)}}
      }
    \end{itemize}
  }

  % End troubles
  \__put_in_katm_box[title = End Trouble]
  {
    \small
    \begin{itemize}
      \AINestedUnroll{#2} {
        \AIUnrolled{\l__trouble_narrative_tl}{2}
        \AIUnrolled{\l__trouble_description_tl}{3}
        \AIUnrolled{\l__trouble_mechanics_tl}{4}
      \item {\bfseries \AIUnrolledE{1} :}  % Action
        \tl_if_empty:NF \l__trouble_narrative_tl
        {{~\it \AIquoteFont \selectfont \color{AIwhite} \l__trouble_narrative_tl}}
        \tl_if_empty:NF \l__trouble_description_tl
        {{\color{AIkatmboxteal} {} ~ {\textbar} \nobreakspace \l__trouble_description_tl }}
        \tl_if_empty:NF \l__trouble_mechanics_tl {{} ~ \mbox{(\l__trouble_mechanics_tl)}}
      }
    \end{itemize}
  }

  % Make weakness box if non-empty weakness option
  \tl_if_eq:VnF {\l_monster_weakness_tl} {}
  {
    \__put_in_katm_box[title = Weakness]
    {
      {
        \color{AIkatmboxteal}
        \small
        \begin{itemize}
          \AINestedUnroll{#3} {
            \AIUnrolled{\l__trouble_mechanics_tl}{2}
          \item {\bfseries \AIUnrolledE{1} :}  % Action
            \tl_if_empty:NF \l__trouble_mechanics_tl {~{\color{AIwhite} \l__trouble_mechanics_tl}}
          }
        \end{itemize}
      }
    }
  }
  \vspace{0.15cm}
}


\NewDocumentCommand {\AIMonsterTroubles} {m m m}
{
  \noindent 
  \tl_if_eq:VnTF \l_monster_style_tl {katm}
  % Do Key and the Machine style
  { \__katm_troubles{#1}{#2}{#3} }
  % Fallback on core rulebook style
  { \__core_troubles{#1}{#2}{#3} }
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Helper stuff for AIMonsterHarvest

\dim_new:N \l__letterheight_dim    % Used to calculate space above katm harvest box

% Helper to render the looting. Looks the same for both katm and core.
\NewDocumentCommand{\__render_looting}{ m m }
{
  \textbf{Looting}\\
  \AIloot{#1}\\
  \AIbloodsymbol {} ~ #2
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%       AIMonsterHarvest
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Optional argument gives number of choices from harvest table.
% m1 is seq of >-separated harvest entries: symbol > item > quantity (see harvest key above).
% m2 is loot quantity (e.g. +1).
% m3 is blood (e.g. Normal blood).

\NewDocumentCommand {\AIMonsterHarvest} {O{}}
{
  \noindent
  \small
  
  % Use begingroup, in case we interfere with some variable that is
  % used elsewhere in AIMonsterData.
  % Especially calling \keys_set again could warrant this.
  \begingroup
  \keys_set:nn { astroinferno / monster / monsterdata } {#1}
  
  % Use global value if monsterstyle option not set
  \tl_if_empty:NT \l_monster_style_tl
  { \tl_set:NV \l_monster_style_tl \l_monster_global_style_tl }
  
  \tl_if_eq:VnTF {\l_monster_style_tl} {katm}
  {
    % ===- Key and the Machine style -===
    %
    % First add some vertical space. Default is a bit big for my taste, but it can be changed with the harvestgap option.
    % Put letter X in a box, measure to create appropriate rule to push down baseline for minipage.
    \hbox_set:Nn \l_tmpa_box { X } 
    \dim_set:Nn \l__letterheight_dim { \box_ht:N \l_tmpa_box + \l_monster_harvestgap_tl }
    \rule{0pt}{\l__letterheight_dim}
    % Put harvest and loot in one minipage below the gap
    \begin{minipage}[t]{\columnwidth} % ------------------\
      %
      % Left Column
      \begin{minipage}[t]{0.67\columnwidth}
        \textbf{\MakeUppercase{\scriptsize \l_monster_name_tl {}~-~Choose~{\l_monster_harvestchoose_tl}}}\\
        \begin{tcolorbox}[
          unbreakable,
          enhanced~jigsaw,
          parbox       = false,
          sharp~corners,
          toptitle     = 0pt,
          bottomtitle = 0pt,
          titlerule      = 0pt,
          boxrule      = 0.5pt, 
          beforeafter~skip  = 0.15cm,
          left          = 3.5pt,
          right        = 3.5pt,
          top          = 2.5pt,
          bottom       = 2.5pt,
          opacityfill = 0.0,
          opacitytext = 1.0,
          opacityframe = 1.0,
          colupper = AIcurrentcolour,
          colframe = AIcurrentcolour
          ]
          {
            \scriptsize
            \AINestedUnroll{\l_monster_harvest_tl} {
              \makebox[0.5cm][l]{\AIUnrolledE{1}}  % Symbol
              \textbf{\AIUnrolledE{2}}  % Item
              \hfill {\tiny \AIUnrolledE{3}}\\  % Quantity
            }
          }
        \end{tcolorbox}
      \end{minipage}
      %
      \hfill
      %
      % Right Column
      \begin{minipage}[t]{0.29\columnwidth}
        \__render_looting{\l_monster_lootqty_tl}{\l_monster_lootblood_tl}
      \end{minipage}
    \end{minipage} % --------------------------------/
  }
  { % ===- Core Rulebook style -===
    %
    \begin{minipage}[t]{\columnwidth} % ------------------\
      % Left Column
      \begin{minipage}[t]{0.60\textwidth}
        \raggedright
        \textbf{Harvesting}~{\scriptsize(Choose~{\l_monster_harvestchoose_tl})}\\
        \AINestedUnroll{\l_monster_harvest_tl} {
          \makebox[0.5cm][l]{\AIUnrolledE{1}}  % Symbol
          \textbf{\AIUnrolledE{2}}  % Item
          \hfill {\AIUnrolledE{3}}\\  % Quantity
        }
      \end{minipage}
      %
      \hfill
      %
      % Right Column
      \begin{minipage}[t]{0.38\columnwidth}
        \raggedleft
        \__render_looting{\l_monster_lootqty_tl}{\l_monster_lootblood_tl}
      \end{minipage}
    \end{minipage} % --------------------------------/
  }

  \endgroup
}
