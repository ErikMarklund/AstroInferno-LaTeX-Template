\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Monster environments
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Simple stat block to mimic Astro Inferno adversary blocks in the rulebook
\DeclareTColorBox {__AIMonster} { O{} }
  {
    enhanced,
    width=\columnwidth,
    frame~hidden,
    unbreakable,
    boxrule     = 0pt,
    breakable,
    parbox      = false,
    boxsep      = 0pt,
    toptitle    = 3mm,
    left        = 0pt,
    right       = 0pt,
    sharp~corners,
    opacityback = 0,
    fontupper   = \AIFontStatBlockBody,
    fontlower   = \AIFontStatBlockBody,
    coltitle    = .,
    #1
  }

\keys_define:nn { astroinferno / monster / monsterdata }
{
  % We want this to set up the font for the title.
  titlefont .tl_set:N =\l_monster_titlefont_tl,
  titlefont .initial:n   = \l__AI_stat_block_title_family_tl,
  titlestyle .tl_set:N = \l_monster_titlestyle_tl,
  titlestyle .initial:n = \l__AI_stat_block_title_style_tl,
  titleheight .tl_set:N  = \l_monster_titleheight_tl,
  titleheight .initial:n  = -1pt, % if -1, use 1ex
  titleheight .value_required:n = true,
  titlealign .tl_set:N  = \l_monster_titlealign_tl,
  titlealign .initial:n  = t,
  titlealign .value_required:n = true,
  %
  type .tl_set:N  = \l_monster_type_tl,
  type .initial:n  = -~unknown~-,
  type .value_required:n  = true,
  class .tl_set:N  = \l_monster_class_tl,
  class .initial:n  = -~unknown~-,
  class .value_required:n  = true,
  being .tl_set:N  = \l_monster_being_tl,
  being .initial:n  = -~unknown~-,
  being .value_required:n  = true,
  damage .tl_set:N  = \l_monster_damage_tl,
  damage .initial:n  = 0,
  damage .value_required:n  = true,
  mortality .tl_set:N  = \l_monster_mortality_tl,
  mortality .initial:n  = 0,
  mortality .value_required:n  = true,
  bones .tl_set:N  = \l_monster_bones_tl,
  bones .initial:n  = 0,
  bones .value_required:n  = true,
  % Troubles and endtroubles should be semicolon-separated lists,
  % because they need to accept commas in the items.
  troubles .tl_set:N  = \l_monster_troubles_raw_tl,
  troubles .initial:n  = {e},
  troubles .value_required:n  = true,
  endtroubles .tl_set:N  = \l_monster_end_troubles_raw_tl,
  endtroubles .initial:n  = {e},
  endtroubles .value_required:n  = true,
  traits .tl_set:N  = \l_monster_traits_tl,
  traits .initial:n  = -~unknown~-,
  traits .value_required:n  = true,
  description .tl_set:N  = \l_monster_description_tl,
  description .initial:n  = -~unknown~-,
  description .value_required:n  = true,
  % Harvest should be a comma-separated list of items.
  % Each item is {symbol, item, qty}. For example,
  % {symbol=\AIsecularsymbol, item=Erthian ingots, qty={\scriptsize 1D6}/\AIspsymbol}
  harvest .tl_set:N = \l_monster_harvest_tl,
  harvest .initial:n  = {},
  harvest .value_required:n  = true,
  harvestchoose .tl_set:N = \l_monster_harvestchoose_tl,
  harvestchoose .initial:n  = one,
  harvestchoose .value_required:n  = true,
  lootqty .tl_set:N  = \l_monster_lootqty_tl,
  lootqty .initial:n  = {0},
  lootqty .value_required:n  = true,
  lootblood .tl_set:N  = \l_monster_lootblood_tl,
  lootblood .initial:n  = -~unknown~-,
  lootblood .value_required:n  = true  
}
  
\NewDocumentEnvironment{AIMonster} {O{} m}
{
  \tl_set:Nn  \l_monster_name_tl {#2}
  \begin{__AIMonster}[#1]
}
{
\end{__AIMonster}
}

\dim_new:N \l_theheight_dim
\NewDocumentCommand{\AIMonsterData} {O{}}
{
  \keys_set:nn { astroinferno / monster / monsterdata } {#1}

   % Split the raw token lists by semicolons into a sequence
  \seq_set_split:NnV \l_monster_troubles_seq { ; } \l_monster_troubles_raw_tl
  \seq_set_split:NnV \l_monster_end_troubles_seq { ; } \l_monster_end_troubles_raw_tl
 
  % Print name
  % Is titleheight set? If >=0 then yes.
  \dim_compare:nTF {\l_monster_titleheight_tl < 0pt}
  { \dim_set:Nn \l_theheight_dim {1ex} } % Set to 1ex
  { \dim_set:Nn \l_theheight_dim {\l_monster_titleheight_tl} } % Set to titleheight

  { \l_monster_titlefont_tl \l_monster_titlestyle_tl \selectfont
    \parbox[t][\l_theheight_dim][\l_monster_titlealign_tl]{\columnwidth} {
      \hfill \l_monster_name_tl \hfill\null
    }\\[2mm]
  }
  \hfill\MakeUppercase{\textbf {\scriptsize{\l_monster_type_tl}}}\hfill\null\\[1.5em]
  \hfill\textls[300]{\MakeUppercase{\textbf{\large{\l_monster_class_tl}}}}\hfill\null\\[0.3em]
  \hfill\textls[60]{\MakeUppercase{\textbf {\large{\l_monster_being_tl}}}}\hfill\null\\
  % Damage, mortality, bones
  \hfill
  \AIdamage{\l_monster_damage_tl}\hspace{2em}
  \AImortality{\l_monster_mortality_tl}\hspace{2em}
  \AIbones{\l_monster_bones_tl}
  \hfill\null\\[0.6em]
  % Troubles
  \AIMonsterTroubles{\l_monster_troubles_seq}{\l_monster_end_troubles_seq}
  \hfill\MakeUppercase{\textbf {\scriptsize{\l_monster_traits_tl}}}\hfill\null\\[0.4em]
  {\small{\l_monster_description_tl}\\[1em]}
  % Harvest and loot
   \AIMonsterHarvest[\l_monster_harvestchoose_tl]
   {\l_monster_harvest_tl}{\l_monster_lootqty_tl}{\l_monster_lootblood_tl}
}

\NewDocumentCommand {\AIMonsterTroubles} {m m}
{
  % Here, we make two minipages that side by side,
  % but each wider than half a column, separated by
  % a negative space. Why? Because this can allow some
  % (end)troubles to be longer than half a line without
  % linebreaks. The downside is that the texts might overlap.
  % If that happens, fix manually by reordering the (end)troubles
  % or inserting manual linebreaks where needed.
  % Other solutions are possible, but this should work most
  % of the time and is simple.
  \noindent
  \small
  \begin{minipage}[t]{0.7\columnwidth}
    \textbf{\textls[200]{\footnotesize TROUBLES}}\\
    \it
    \seq_use:Nn #1 { \\ } 
  \end{minipage}
  \hspace{-0.61\columnwidth}
  \hfill
  \begin{minipage}[t]{0.7\columnwidth}
    \raggedleft
    \textbf{\textls[200]{\footnotesize END~TROUBLE}}\\
    \it
    \seq_use:Nn #2 { \\ }
  \end{minipage}\\

  \vspace{\baselineskip} % Add vertical space after the lists
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Helper stuff for AIMonsterHarvest
\tl_new:N \l__harvest_tl
\seq_new:N \l__harvest_seq

% Storage for the active item attributes
\tl_new:N \l__harvest_symbol_tl
\tl_new:N \l__harvest_item_tl
\tl_new:N \l__harvest_qty_tl

\keys_define:nn { astroinferno / harvest / item }
{
  symbol .tl_set:N = \l__harvest_symbol_tl,
  item  .tl_set:N = \l__harvest_item_tl,
  qty   .tl_set:N = \l__harvest_qty_tl,
}

% Brace-stripping helper macro.
\cs_new_protected:Nn \__monster_evaluate_harvest_keys:n
{ \keys_set:nn { astroinferno / harvest / item } { #1 } }
  
\cs_new_protected:Nn \__monster_render_harvest_line:n
{
  % Clear variables from the previous loop iteration
  \tl_clear:N \l__harvest_symbol_tl
  \tl_clear:N \l__harvest_item_tl
  \tl_clear:N \l__harvest_qty_tl
  
  % FIX: Pass the item through our brace-stripper first
  \__monster_evaluate_harvest_keys:n #1
  
  % Print exactly: symbol item \hfill qty
  \makebox[0.5cm][l]{\l__harvest_symbol_tl} \textbf{\l__harvest_item_tl} 
  \hfill \l__harvest_qty_tl \\
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Overall not so happy about this one. Too complicated with all the helper functions.
%
% Optional argument gives number of choices from harvest table.
% m1 is pairs of harvest table entries {{h1, ammount1}, {h2, ammount2}, ... }
% m2 is loot and blood.
\NewDocumentCommand {\AIMonsterHarvest} {O{one} m m m}
{
  \noindent
  \small
  
  % Drop the outer items into a sequence array if you need it for other layout math
  \seq_set_from_clist:Nn \l__harvest_seq {#2}
  
  % Left Column
  \begin{minipage}[t]{0.60\textwidth}
    \raggedright
    \textbf{Harvesting}~{\scriptsize(Choose~{#1})}\\
    \clist_map_function:NN #2 \__monster_render_harvest_line:n
  \end{minipage}
  \hfill
  
  %Right Column
  \begin{minipage}[t]{0.38\columnwidth}
    \raggedleft
    \textbf{Looting}\\
    \AIloot{#3}\\
    #4
  \end{minipage}
  
  \vspace{\baselineskip} % Add vertical space after the lists
}
