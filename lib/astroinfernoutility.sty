%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Some keys are required for proper execution of macros.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\msg_new:nnn { astroinferno } { key_required } { #1~requires~key~``#2''~to~be~set. }

% #1 - key value
% #2 - macro name
% #3 - key name
\cs_new_protected:Npn \__AI_check_for_key:Nnn #1#2#3
  {
    \group_begin:
      \str_set:Nx \l_tmpa_str { #1 }

      \str_if_empty:NT { \l_tmpa_str }
        { \msg_error:nnnn { astroinferno } { key_required } { #2 } { #3 } }
    \group_end:
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Print tiers, distances, bonuses consistently
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Print uppercase roman numerals
\NewExpandableDocumentCommand\ROM{m}
  { \int_to_Roman:n {#1} } 

\msg_new:nnnn { astroinferno } { invalid-tier }
{ Invalid~tier~'#1'~provided! }
{ Tier~must~be~an~integer~between~1~and~5. }

% Print tiers (e.g., Ordinary II).
\NewExpandableDocumentCommand\AITier{m}
{
  \int_case:nnF {\int_eval:n {#1}} {
    {1} {Mundane\nobreakspace\ROM{#1}}
    {2} {Ordinary\nobreakspace\ROM{#1}}
    {3} {Excellent\nobreakspace\ROM{#1}}
    {4} {Masterful\nobreakspace\ROM{#1}}
    {5} {Excellent\nobreakspace\ROM{#1}}
  } {}
}

% Print distances (e.g., Room II).
\NewExpandableDocumentCommand\AIDist{m}
{
  \int_case:nnF {\int_eval:n {#1}} {
    {1} {Intimate\nobreakspace\ROM{#1}}
    {2} {Room\nobreakspace\ROM{#1}}
    {3} {Hall\nobreakspace\ROM{#1}}
    {4} {Palace\nobreakspace\ROM{#1}}
    {5} {City\nobreakspace\ROM{#1}}
  } {\msg_error:nnn { astroinferno } { invalid-tier } { #1 }}
}

% Print bonuses. 3 -> +3, -2 -> -2, 0 -> +0. Mainly for internal use.
\NewDocumentCommand\AIBonus{m}
{
  \int_compare:nTF {\int_eval:n {#1} > -1 }
  {+ #1}
  {#1}
}

% Print numbers with leading zero if single digit
\NewDocumentCommand\AIleadzero{m}
{
  \int_compare:nTF {\int_eval:n {#1} < 10 }
  { 0{#1} }
  { #1 }
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% We use a standard format for nested lists (2 levels), which we call AINested.
% Outer level is ;-separated, inner is >-separated. For example:
% { item1 > prop1 > qty1 ; item2 > prop2 > qty2 ; ...}
%
% We have a function for unrolling these lists, \AINestedUnroll.
%
% \AINestedUnroll takes two arguments:
% 1) token-list variable holding the nested list.
% 2) code, which is  executed for every item on the outer level on the list.
% The code has access to the elements at the inner level via the variable \l_unroll_seq.
%
% EXAMPLE:
% \tl_new:N \l_nested_tl
% \tl_set:Nn \l_nested_tl {key > lock ; hand > glove}
%  \AINestedUnroll { l_nested_tl } {
%    {\seq_item:Nn \l_unroll_seq {1}}~fits~in~{\seq_item:Nn \l_unroll_seq {2}}\\
%  }
% Outputs
% key fits in lock
% hand fits in glove
%
% \AIUnrolled and \AIUnrolledE makes this even easier,
% hiding the \l_unrolled_tl variable and making more compact code.
%
% EXAMPLE:
% \tl_new:N \l_nested_tl
% \tl_set:Nn \l_nested_tl {key > lock ; hand > glove}
%  \AINestedUnroll { l_nested_tl } {
%    {\AIUnrolledE{1}~fits~in~{\AIUnrolledE {2}}\\
%  }
%
% These two helper functions differ in that \AIUnrolled stores the
% item in a variable, whereas \AIUnrolledE returns it directly, kind
% of like an inline variant.


\seq_new:N \l__unroll_outer_seq
\seq_new:N \l_unroll_seq

% Internal function
% #1 = token list variable containing the nested list
% #2 = inline code to execute per inner pair
\cs_new_protected:Nn \__unroll_nested_list:Nn
{
  % Split the outer list by ';'
  \seq_set_split:NnV \l__unroll_outer_seq { ; } #1
  
  % Loop through each outer item
  \seq_map_inline:Nn \l__unroll_outer_seq
  {
    % Split the current item (##1) by '>'
    \seq_set_split:Nnn \l_unroll_seq { > } { ##1 }

    % Execute code (#2)
    #2
  }
}

% The first and maybe only fucntion you need to call to unroll.
\NewDocumentCommand{\AINestedUnroll}{ +m +m }
{ \__unroll_nested_list:Nn #1 {#2} }

% Facilitates accessing the inner-level elements.
% First command is token list variable in which to store the value.
% Second argument is index of element to get.
\NewDocumentCommand{\AIUnrolled}{m m}
{ \tl_set:Ne #1 { \seq_item:Nn \l_unroll_seq {#2} } }

% Just returns the element indicated by #1.
% Sort of an inline variant of \AIUnrolled.
% ('E' is for 'element', which is maybe not super logical, but 'I' for
% 'Inline' looks too much like a small 'L'. 'E' for 'express'?)
\NewDocumentCommand{\AIUnrolledE} {m}
{ \seq_item:Nn \l_unroll_seq { #1 } }