\box_new:N \l__AI_space_box
\hbox_set:Nn \l__AI_space_box {~}
\dim_new:N \l__AI_space_dim
\dim_set:Nn \l__AI_space_dim { \box_wd:N \l__AI_space_box }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Some keys are required for proper execution of macros.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\msg_new:nnn { astroinferno } { key_required } { #1~requires~key~``#2''~to~be~set. }

% #1 - key value
% #2 - macro name
% #3 - key name
\cs_new_protected:Npn \__AI_check_for_key:Nnn #1#2#3
  {
    \group_begin:
      \str_set:Nx \l_tmpa_str { #1 }

      \str_if_empty:NT { \l_tmpa_str }
        { \msg_error:nnnn { astroinferno } { key_required } { #2 } { #3 } }
    \group_end:
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Print tiers, distances, bonuses consistently
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Print uppercase roman numerals
\NewExpandableDocumentCommand\ROM{m}
  { \int_to_Roman:n {#1} } 

\msg_new:nnnn { astroinferno } { invalid-tier }
{ Invalid~tier~'#1'~provided! }
{ Tier~must~be~an~integer~between~1~and~5. }

% Print tiers (e.g., Ordinary II).
\NewExpandableDocumentCommand\AITier{m}
{
  \int_case:nnF {\int_eval:n {#1}} {
    {1} {Mundane~\ROM{#1}}
    {2} {Ordinary~\ROM{#1}}
    {3} {Excellent~\ROM{#1}}
    {4} {Masterful~\ROM{#1}}
    {5} {Excellent~\ROM{#1}}
  } {}
}

% Print distances (e.g., Room II).
\NewExpandableDocumentCommand\AIDist{m}
{
  \int_case:nnF {\int_eval:n {#1}} {
    {1} {Intimate~\ROM{#1}}
    {2} {Room~\ROM{#1}}
    {3} {Hall~\ROM{#1}}
    {4} {Palace~\ROM{#1}}
    {5} {City~\ROM{#1}}
  } {\msg_error:nnn { astroinferno } { invalid-tier } { #1 }}
}

% Print bonuses. 3 -> +3, -2 -> -2, 0 -> +0. Mainly for internal use.
\NewDocumentCommand\AIBonus{m}
{
  \int_compare:nTF {\int_eval:n {#1} > -1 }
  {+ #1}
  {#1}
}

% Print numbers with leading zero if single digit
\NewDocumentCommand\AIleadzero{m}
{
  \int_compare:nTF {\int_eval:n {#1} < 10 }
  { 0{#1} }
  { #1 }
}
