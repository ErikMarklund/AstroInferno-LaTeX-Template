\RequirePackage{lettrine}
\RequirePackage{Royal}
\RequirePackage[auto]{contour}

\bool_if:NT \l__AI_layout_bool
  {
    % \RequirePackage{bookman}
    \RequirePackage{fontspec}
    \RequirePackage{lato}
    \RequirePackage[type1]{gillius2}
    \RequirePackage[notext,nomath,nott]{kpfonts}
    \RequirePackage[T1]{fontenc}
    \renewcommand{\sfdefault}{jkpss}
    \setmainfont{Lato}
    \setsansfont{Lato}
    \renewcommand{\familydefault}{\rmdefault}

    \newfontfamily\AIfontAvalenRekas{Avalen~Rekas.ttf}
    \newcommand{\AIpartfont}{\AIfontAvalenRekas}
    \newcommand{\AIchapterfont}{\AIfontAvalenRekas}
    \newcommand{\AIsectionfont}{\AIfontAvalenRekas}

    \newfontfamily\AIfontMuara{MUARA-DEMO.ttf}
    \newcommand{\AIsubsectionfont}{\AIfontMuara}
    \newcommand{\AIsubsubsectionfont}{\AIfontMuara}

    \newfontfamily\AIfontIMFellEnglish{IMFellEnglish-Regular.ttf}[
    Path = IM_Fell_English/,
    Extension = .ttf,
    UprightFont = *,
    ItalicFont = IMFellEnglish-Italic
    ]
    \newcommand{\AIquoteFont}{\AIfontIMFellEnglish}

    \newfontfamily\AIfontEroded{ERODED~PERSONAL~USE.ttf}[
    Path = eroded-personal-use/,
    Extension = .ttf,
    UprightFont = *]
  }



\cs_new_protected:Npn \__AI_sf_initial_family:
  {
    \bool_if:NTF \l__AI_layout_bool
      { \gilliustwo }
      { \sffamily }
  }

