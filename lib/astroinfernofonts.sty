\bool_new:N \g_AlchemyCopyright_bool

\NewDocumentCommand\AlchemyCopyright{}
{
  \bool_if:NTF \g_AlchemyCopyright_bool
  { © }
  { { \normalfont {©} } }
}

\bool_if:NT \l__AI_layout_bool
  {
    % \RequirePackage{bookman}
    \RequirePackage{fontspec}
    \RequirePackage{lato}
    \RequirePackage[notext,nomath,nott]{kpfonts}
    \RequirePackage[T1]{fontenc}
    \setmainfont{Lato}
    \setsansfont{Lato}
    \renewcommand{\familydefault}{\rmdefault}

    % For LuaLaTeX, \fontseries{eb} etc. falls back to \bfseries.
    % Need to define separately
    \newfontfamily\latoblack{Lato Black}

    % ======== Font checks ========
    % This template uses fallbacks for several key fonts in the
    % folowing manner:
    % 1. Load official font if installed on the system.
    % 2. Load official font if found in the fonts/ directory.
    %     TrueType is assumed, unless OTF is likely (depends on which font),
    %     and assumptions are made about file names.
    %     If file names differ, adjust either template or file names.
    % 3. Load fallback font if installed on the system.
    % 4. Load fallback font if found in the fonds/ directory.
    %     Several "official" and unofficial fallback fonts are included.
    % =========================

    % ======== Font names ========
    % Fonts are named \AIfontX, where X is the font name.
    % For example, \AIfontAvalenRekas.
    %
    % Fallback fonts are named as the primary font.
    % For example, Dominican is loaded as \AIfontAlchemy.
    %
    % A number of font aliases are defined below, which are named
    % \AIXFont, where X is a description/use. For example,
    % \AIoldenglishFont is an alias for \AIfontQTCloisteredMonk.
    %
    % Some separate aliases are made for specific layout elements,
    % such as \AIpartfont

    \newfontfamily{\AIfontQTCloisteredMonk}{qtcloisteredmonk}
    \newcommand{\AIoldenglishFont}{\AIfontQTCloisteredMonk}

    \newfontfamily\AIfontAvalenRekas{Avalen~Rekas.ttf}[Path = fonts/]
    \newcommand{\AIpartFont}{\AIfontAvalenRekas}
    \newcommand{\AIchapterFont}{\AIfontAvalenRekas}
    \newcommand{\AIsectionFont}{\AIfontAvalenRekas}

    % Check if Muara exists. Otherwise load MUARA DEMO
    \IfFontExistsTF{Muara} {
      \newfontfamily\AIfontMuara{Muara}
    } {
      % Look for font in fonts/
      \IfFontExistsTF{fonts/Muara.ttf}
      {\newfontfamily\AIfontMuara{Muara.ttf}[Path = fonts/, Extension = .ttf,UprightFont = *]}
      {
        % Original file name is "MUARA DEMO .ttf", but trailing space
        % causes problem, so file was renamed.
        \newfontfamily\AIfontMuara{MUARA~DEMO.ttf} [ Path = fonts/, Extension = .ttf, UprightFont = * ]
      }
    }

    % Make (sub)subsection font alias
    \newcommand{\AIsubsectionFont}{\AIfontMuara}
    \newcommand{\AIsubsubsectionFont}{\AIfontMuara}

    % The 1651 Alchemy font replacements are difficult. All have some drawbacks.
    % One alternative could be Caslon Antique, but the digits look wrong.
    % Use 1651 Alchemy if available. Otherwise Dominican, then IM FELL English
    \IfFontExistsTF{1651~Alchemy}
    {
      % Is Contextuals = Alternate needed when loading like this?
      \newfontfamily\AIfontAlchemy{1651~Alchemy}
      \bool_gset_true:N \g_AlchemyCopyright_bool
    }
    { % Look for font file in fonts/
      \IfFontExistsTF{fonts/GLC~-~1651AlchemyNormal.otf}
      {
        \newfontfamily\AIfontAlchemy{GLC~-~1651Alchemy.otf} [
        Path = fonts/1651~Alchemy~Family/,
        Extension = .otf,
        UprightFont    = * Normal,
        ItalicFont     = * Italic,
        Contextuals    = Alternate ]
        \bool_gset_true:N \g_AlchemyCopyright_bool
      } { % First fallback Dominican. Free, but cannot be bundled.
        % Only read from file, because when installing my OS sees three
        % different fonts.
        \bool_gset_false:N \g_AlchemyCopyright_bool % We can't trust
        \IfFontExistsTF{fonts/dominican/DOMINICA.TTF}
        {
          \newfontfamily\AIfontAlchemy{DOMINICA.TTF}[
          Path = fonts/dominican/,
          Extension = .TTF,
          UprightFont  = DOMINICA,
          ItalicFont = DOMII___,
          SmallCapsFont = DOMISC__ ]
        } { % Load bundled fallback IM FELL English
          \IfFontExistsTF{IM~FELL~English} {
            \newfontfamily\AIfontAlchemy{IM~FELL~English}
          } { % :Load fallback from file instead
            \newfontfamily\AIfontAlchemy{IMFellEnglish-Regular.ttf}[
            Path = fonts/IM_Fell_English/,
            Extension = .ttf,
            UprightFont = *,
            ItalicFont = IMFellEnglish-Italic ]
          }
        }
      }
    }

    \newcommand{\AIquoteFont}{\AIfontAlchemy}

    \newfontfamily\AIfontCheddarGothic{CheddarGothicRough-Regular.otf}[
    Path = fonts/cheddar_gothic_rough_fonts/,
    Extension = .otf,
    UprightFont = *,
    ItalicFont = CheddarGothicRough-Italic.otf]
    \newcommand{\AIerodedblockFont}{\AIfontCheddarGothic}
  }

  % Load Bahnschrift font if available.
  \IfFontExistsTF{Bahnschrift}
  {\newfontfamily\AIfontBahnschrift{Bahnschrift}[
    BoldFont={Bahnschrift},
    BoldFeatures={Weight=700},
    ItalicFont={Bahnschrift},
    ItalicFeatures={FakeSlant=0.2},
    BoldItalicFont={Bahnschrift},
    BoldItalicFeatures={Weight=700, FakeSlant=0.2}
    ]
  } {\IfFontExistsTF{fonts/Bahnschrift/Bahnschrift.ttf}
    {
      \newfontfamily\AIfontBahnschrift{Bahnschrift.ttf}
      [Path = fonts/Bahnschrift/,
      BoldFont={Bahnschrift},
      BoldFeatures={Weight=700},
      ItalicFont={Bahnschrift},
      ItalicFeatures={FakeSlant=0.2},
      BoldItalicFont={Bahnschrift},
      BoldItalicFeatures={Weight=700, FakeSlant=0.2}]
    } { % Load fallback D-DIN
      \newfontfamily\AIfontBahnschrift{D-DIN.otf}[
      Path = fonts/d-din/,
      Extension = .otf,
      UprightFont = *,
      ItalicFont = *-Italic,
      BoldFont = *-Bold]
    }
  }
  \newcommand{\AImechanicalFont}{\AIfontBahnschrift}

