\definecolor {AImidsteelgray} {HTML} {394044} % Used in some boxes
\definecolor {AIdarksteelgray} {HTML} {171B27} % Used in some boxes

% The color used in \AISetThemeColor when a new color is not set
\colorlet {themecolor} {AIlightteal}

\NewDocumentCommand{\AIDarkColors} {} {
  \colorlet {AItableodd} {AIred}
  \colorlet {AItableeven} {AIbrightred}
  \colorlet {commentcolor} {AImidgraybrown}
  \colorlet {readaloudcolor} {AImidsteelgray}
  \colorlet {sidebarcolor} {AIdeepred}
}
\NewDocumentCommand{\AILightColors} {} {
  \colorlet {AItableodd} {AIlightteal}
  \colorlet {AItableeven} {AImidteal}
  \colorlet {commentcolor} {AIdarkteal}
  \colorlet {readaloudcolor} {AIlightteal}
  \colorlet {sidebarcolor} {AImidgray}
}
% Element colors that change when \AISetThemeColor is used
\colorlet {commentcolor} {themecolor} % AIComment background
\colorlet {sidebarcolor} {themecolor} % AISidebar background
\colorlet {tablecolor}   {themecolor} % AITable even row background

% Sets the themecolor and colors for all themed elements
% If called without the optional color, resets the color of all themed elements to the current themecolor
\NewDocumentCommand {\AISetThemeColor} { O {themecolor} }
  {
    \colorlet {themecolor}   {#1}
    \colorlet {commentcolor} {#1}
    \colorlet {sidebarcolor} {#1}
    \colorlet {tablecolor}   {#1}
  }
