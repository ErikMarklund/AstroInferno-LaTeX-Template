\definecolor {AIorange} {HTML} {F8A320}
\definecolor {AIyellow} {HTML} {FEC315}
\definecolor {AIundyingblue} {HTML} {00AEEF}
\definecolor {AIpaleblue} {HTML} {7ECCE7} % Seen in Destiny section
\definecolor {AIpetroleum} {HTML} {00A3DA} % Seen in Destiny section
\definecolor {AIlightteal} {HTML} {E7E7E7} % Used in some tables, boxes
\definecolor {AImidteal} {HTML} {D6D0BF}  % Used in some tables, boxes
