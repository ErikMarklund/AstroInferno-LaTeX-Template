% Define Monster subsection header style
\newcommand{\monstersection}[1]{%
  \AIDeprecate{\noexpand\monstersection}{1.0.0}{Use \noexpand\AIMonsterSection for stat blocks sections.}%
  \begingroup
    \par\medskip\noindent
    \AIFontStatBlockSection #1
    % \rule is a horizontal command, so placing it under the title incurs extra
    % line spacing. Use \hrule (a vertical command) instead.
    \vspace{3pt}
    \hrule height 0.6pt
    \vspace{2pt}
  \endgroup%
}

\NewDocumentEnvironment{monsteraction}{o}{%
  \AIDeprecate{\noexpand\monsteraction}{1.0.0}{Use \noexpand\AIMonsterAction for stat block actions.}%
  \IfValueTF{#1}{%
    \par\medskip\noindent\emph{\textbf{#1.}}%
  }{\unskip}%
}{\par}

