\newkeycommand\monsterattack[
    name=Dagger,
    enum* type={both,melee,ranged},
    mod=+0,
    reach=5,
    range=20/60,
    targets=\defaulttargetsname,
    dmg=\dice{1d4},
    dmgtype=piercing,
    plusdmg=,
    plusdmgtype=,
    ordmg=,
    ordmgwhen=,
    extra=,
  ]{%
  \AIDeprecate{\noexpand\monsterattack}{1.0.0}{Use \noexpand\AIMonsterMelee, \noexpand\AIMonsterRanged, or \noexpand\AIMonsterAttack for attacks that are melee, ranged, or both, respectively.}%
  \begin{monsteraction}[\commandkey{name}]
    \IfStrEqCase{\commandkey{type}}{%
      {melee}{\textit{\AICaption{\meleeattackname}{\weaponname}:} \astroinferno@hit{mod}, \reachname\ \commandkey{reach} \unitsname}%
      {ranged}{\textit{\AICaption{\rangedattackname}{\weaponname}:} \astroinferno@hit{mod}, \rangename\ \commandkey{range} \unitsname}%
      {both}{\textit{\AICaption{\meleeorrangedattackname}{\weaponname}:} \astroinferno@hit{mod}, \reachname\ \commandkey{reach} \unitsname\ \orname\ \rangename\ \commandkey{range} \unitsname}%
    }[]%
    , \commandkey{targets}.
    \textit{\hitname:} \astroinferno@damage{dmg}{dmgtype}%
    \astroinferno@ifplusdmg{plusdmg}{plusdmgtype}%
    \astroinferno@ifordmg{ordmg}{dmgtype}{ordmgwhen}{plusdmg}{plusdmgtype}%
    \ifcommandkey{extra}{\commandkey{extra}}{}.
  \end{monsteraction}
}

