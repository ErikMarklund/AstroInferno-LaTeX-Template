% A astroinferno@monsterattrs helper macro that always displays an attribute.
\newcommand{\astroinferno@monsterattr}[2]{%
  \item[#2] \commandkey{#1}
}

% A astroinferno@monsterattrs helper macro that displays an attribute if the user defined
% it.
\newcommand{\astroinferno@ifmonsterattr}[2]{%
  \ifcommandkey{#1}{%
    \item[#2] \commandkey{#1}
  }{}%
}

