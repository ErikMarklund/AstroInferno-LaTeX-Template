\ExplSyntaxOn

\definecolor{AIcurrentcolour}{rgb}{0,0,0}
\definecolor{AIdarkbox}{rgb}{0.3,0.3,0.3}
\definecolor{AIlightbox}{rgb}{0.7,0.7,0.7}

\bool_new:N \g_AI_dark_mode_bool


% Provide a default initial colour name so fontspec doesn't crash during preamble compilation
%\gdef\AICurrentThemeColourName{AIblack}

% Updated to NewDocumentCommand with a mandatory argument 'm'
\NewDocumentCommand{\AISSetGlobalColour}{ m }
{
  \color{#1}% Set local color
  \colorlet {AIcurrentcolour}{#1}
}

%%%%%%%%%%%% Dark mode %%%%%%%%%%%%
%
\keys_define:nn { astroinferno / darkpages / dark }
{
  % text is the textcolour
  text .tl_set:N  = \l_dark_text_tl,
  text .default:n  = AIwhite,
  text .initial:n  = AIwhite,
  background .tl_set:N  = \l_dark_background_tl,
  background .default:n  = img/paper-darkred,
  % If backgroundfill is non-empty, a recatangle with colour
  % backgroundfill will be used instead of image background
  backgroundfill .tl_set:N  = \l_dark_backgroundfill_tl,
  backgroundfill .default:n  = {}
}

% Starred version does not clear page.
% First optional argument allows keys to be changed.
% Second optional argument is passed straight to \AIDarkColours.
\NewDocumentCommand{\AIMakeDark} {s O{} O{}}
{

  \keys_set:nn { astroinferno / darkpages / dark } {text, background, backgroundfill, #2}

  \bool_set_true:N \g_AI_dark_mode_bool
  \bool_if:NF{#1}
  {\clearpage}
  \AISSetGlobalColour{\l_dark_text_tl}
  \AIDarkColours[#3]
  \tl_if_empty:NTF \l_dark_backgroundfill_tl
  { % use background image
    \AIPlaceNewBackground{\l_dark_background_tl}
  } { % Use solid colour
    \AIPlaceNewBackgroundColour{\l_dark_backgroundfill_tl}
  }
}


%%%%%%%%%%%% Light mode %%%%%%%%%%%%
%
\keys_define:nn { astroinferno / darkpages / light }
{
  % text is the textcolour
  text .tl_set:N  = \l_light_text_tl,
  text .default:n = AIblack,
  text .initial:n = AIblack,
  background .tl_set:N  = \l_light_background_tl,
  background .default:n  = img/paper-pale,
  % If backgroundfill is non-empty, a recatangle with colour
  % backgroundfill will be used instead of image background
  backgroundfill .tl_set:N  = \l_light_backgroundfill_tl,
  backgroundfill .default:n  = {}
}

\NewDocumentCommand{\AIMakeLight} {s O{} O{}}
{

  % First reset the keys to defaults
  \keys_set:nn { astroinferno / darkpages / light } {text, background, backgroundfill, #2}

  \bool_set_false:N \g_AI_dark_mode_bool
  \bool_if:NF #1
  {\clearpage}
  \AISSetGlobalColour{\l_light_text_tl}
  \AILightColours[#3]
  \tl_if_empty:NTF \l_light_backgroundfill_tl
  { % use background image
    \AIPlaceNewBackground{\l_light_background_tl}
  } { % Use solid colour
    \AIPlaceNewBackgroundColour{\l_light_backgroundfill_tl}
  }
}

%%%%%%%%%%%% Image injection %%%%%%%%%%%%
%
\NewDocumentCommand{\AIPlaceNewBackground} {s m}
{
  \RemoveFromHook{shipout/background} % Must clear earlier background, or the page number position will be broken.
  \bool_if:NTF{#1} {
    \AddToShipoutPictureBG*{
      \AtPageLowerLeft{
        \includegraphics[width=\paperwidth,height=\paperheight]{#2}
      }
    }
  } {
    \AddToShipoutPictureBG{
      \AtPageLowerLeft{
        \includegraphics[width=\paperwidth,height=\paperheight]{#2}
      }
    }
  }
}

\NewDocumentCommand{\AIPlaceNewBackgroundColour} {s m}
{
  \RemoveFromHook{shipout/background} % Must clear earlier background, or the page number position will be broken.
  \bool_if:NTF{#1} {
    \AddToShipoutPictureBG*{
      \begin{tikzpicture}[remember~picture,overlay]
        \fill[color=#2]
        (current~page.south~west) -- (current~page.north~west) --
        (current~page.north~east) -- (current~page.south~east);
      \end{tikzpicture}
    }
  } {
    \AddToShipoutPictureBG{
      \begin{tikzpicture}[remember~picture,overlay]
        \fill[color=#2]
        (current~page.south~west) -- (current~page.north~west) --
        (current~page.north~east) -- (current~page.south~east);
      \end{tikzpicture}
    }
  }
}


%%%%%%%%%%%%% Commands for setting mode colours %%%%%%%%%%%%%
% Pass keys in the optional argument.
% Note that the colour of regular text is not set here.
\keys_define:nn { astroinferno / modecolours / dark }
{
  tableodd .tl_set:N  = \l_dark_tableodd_tl,
  tableodd .default:n  = AIdarksteelgrey,
  tableeven .tl_set:N  = \l_dark_tableeven_tl,
  tableeven .default:n  = AImidsteelgrey,
  comment .tl_set:N  = \l_dark_comment_tl,
  comment .default:n  = AImidgreybrown,
  readaloud .tl_set:N  = \l_dark_readaloud_tl,
  readaloud .default:n  = AImidsteelgrey,
  sidebar .tl_set:N  = \l_dark_sidebar_tl,
  sidebar .default:n  = AIdeepred,
}

\NewDocumentCommand{\AIDarkColours} {O{}} {

  % Passing all keys without values for defaults, then #1 to override
  \keys_set:nn { astroinferno / modecolours / dark }
  {tableodd, tableeven, comment, readaloud, sidebar, #1}

  \colorlet {AItableodd} {\l_dark_tableodd_tl}
  \colorlet {AItableeven} {\l_dark_tableeven_tl}
  \colorlet {commentcolour} {\l_dark_comment_tl}
  \colorlet {readaloudcolour} {\l_dark_readaloud_tl}
  \colorlet {sidebarcolour} {\l_dark_sidebar_tl}
}

\keys_define:nn { astroinferno / modecolours / light }
{
  tableodd .tl_set:N  = \l_light_tableodd_tl,
  tableodd .default:n  = AIlightgrey,
  tableeven .tl_set:N  = \l_light_tableeven_tl,
  tableeven .default:n  = AImidgrey,
  comment .tl_set:N  = \l_light_comment_tl,
  comment .default:n  = AImidteal,
  readaloud .tl_set:N  = \l_light_readaloud_tl,
  readaloud .default:n  = AIlightteal,
  sidebar .tl_set:N  = \l_light_sidebar_tl,
  sidebar .default:n  = AImidgrey,
}

\NewDocumentCommand{\AILightColours} {O{}} {

  % Passing all keys without values for defaults, then #1 to override
  \keys_set:nn { astroinferno / modecolours / light }
  {tableodd, tableeven, comment, readaloud, sidebar, #1}

  \colorlet {AItableodd} {\l_light_tableodd_tl}
  \colorlet {AItableeven} {\l_light_tableeven_tl}
  \colorlet {commentcolour} {\l_light_comment_tl}
  \colorlet {readaloudcolour} {\l_light_readaloud_tl}
  \colorlet {sidebarcolour} {\l_light_sidebar_tl}
}

% Call this to execute #1 if dark mode is on, #2 otherwise
\NewDocumentCommand{\AIIsDarkMode}{mm}
{
  \bool_if:NTF \g_AI_dark_mode_bool {#1} {#2}
}

% Initialise light mode to begin with.
  \AIMakeLight*
