%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Macros for making ready-made elements
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% ======== Titlepage from example.tex ========
% Mandatory argument: Title
% Options:
%   titlefont - font and text properties for the title
%   quote - printed under the logo
%   quotewidth - different quotes require different space
\keys_define:nn { astroinferno / elements / titlepage }
{
  titlefont .tl_set:N = \l__AI_titlepage_titlefont_tl,
  titlefont .initial:n = \AIfontAvalenRekas,
  quote .tl_set:N = \l__AI_titlepage_quote_tl,
  quote .initial:n = {},
  quotewidth .tl_set:N = \l__AI_titlepage_quotewidth_tl,
  quotewidth .initial:n = 0.25\textwidth
}

\NewDocumentCommand\AIMakeElementTitlepage{O{} m}
{
  \keys_set:nn { astroinferno / elements / titlepage } {#1}

  \begin{center}
    \vspace*{\stretch{1}}
    { \l__AI_titlepage_titlefont_tl\selectfont #2\\}
    \vspace{1.5cm}
    \includegraphics[width=0.6\textwidth]{
      \AIIsDarkMode
      {"img/astro-inferno-logo-kit/Astro~Inferno~-~White.png"}
      {"img/astro-inferno-logo-kit/Astro~Inferno~-~Black.png"}
    }\par % Need this or maybe \newline, or else the logo will appear
          % to the right of the text that follows.
    \vspace{1.5cm}
    \hfill
    \begin{minipage}[t]{\l__AI_titlepage_quotewidth_tl}
      {
        \it \AIquoteFont
        \l__AI_titlepage_quote_tl
      }
    \end{minipage}
    \hfill\null
    \vspace*{\stretch{2}}\par
    \hfill
    \begin{minipage}[t]{0.7\textwidth}
      {
        \begin{AISidebar}{}
          \AIcopyright*
        \end{AISidebar}
      }
    \end{minipage}
    \hfill\null
  \end{center}
}

% ======== TOC from example.tex ========
% No arguments or options
\NewDocumentCommand\AIMakeElementTOCpage{}
{
  \begingroup
  \let\clearpage\null % Temporarily disable \clearpage to allow an image to be added below the TOC.
  \tableofcontents
  \onecolumn{
    \begin{center}
      \vfill
      % Choose coven image based on dark/light mode
      \includegraphics[width=0.3\columnwidth]{\AIIsDarkMode
        {"img/astro-inferno-logo-kit/Astro~Inferno~-~Coven~White.png"}
        {"img/astro-inferno-logo-kit/Astro~Inferno~-~Coven~Black.png"}
      }
    \end{center}
    \vspace{2cm}
  }
  \endgroup
  \clearpage % Needed for longer TOCs. Doesn't matter for shorter
  % ones. Also needed as TOC's own \clearpage was disabled above.
  \twocolumn
}

% ======== Page with centered image used as final page in example.tex ========
% Options:
%    mode - dark or light. Other values do nothing.
%    image - image file
%    imagewidth - width of image
%    mode - [dark, light] set dark or light mode
%    modeafter - [dark, light] set dark or light mode after image page
%    clearcolour - make background this colour instead of image.
%                         If not set, the background image will remain.
%    bgimage - background image to use with mode. Default if not set
%    bgimageafter - like bgimage for subsequent pages.
\keys_define:nn { astroinferno / elements / imagepage }
{
  image .tl_set:N = \l__AI_imagepage_image_tl,
  image .initial:n = {},
  imagewidth .tl_set:N = \l__AI_imagepage_imagewidth_tl,
  imagewidth .initial:n = 0.6\textwidth,
  imagewidth .value_required:n  = true,
  clearcolour .tl_set:N = \l__AI_imagepage_clearcolour_tl,
  clearcolour .initial:n = {},
  suppressborder .choices:nn = { true, false } {},
  suppressborder / true .code:n  = \bool_set_true:N  \l__AI_imagepage_suppressborder_bool,
  suppressborder / false .code:n = \bool_set_false:N \l__AI_imagepage_suppressborder_bool,
  suppressborder / unknown .code:n =
  \msg_error:nnnnnn { astroinferno / elements / imagepage } { unknown-choice }
  { suppressborder }
  { true , false }
  { #1 }
  { },
  suppressborder .default:n = true,
  suppressborder .initial:n = true,
}

\bool_new:N \l__AI_imagepage_was_dark_bool
\bool_new:N \l__AI_imagepage_was_border_bool
% New implementation with before-code and after-code.
% Use before- and after-codes to set dark/light mode.
% Clearly more robust than earlier implementation.
% Assumes twocolumn, but probably works in onecolumn if
% \onecolumn is put in after-code (not tested).
\NewDocumentCommand\AIMakeElementImagepage{O{} m m}
{
  \keys_set:nn { astroinferno / elements / imagepage } {#1}

  % Check which mode it was. Restore after1
  \AIIsDarkMode
  { \bool_gset_true:N \l__AI_imagepage_was_dark_bool }
  { \bool_gset_false:N \l__AI_imagepage_was_dark_bool }

  % Run before-code
  { #2 }

  % Should border be suppressed?
  \bool_if:NT \l__AI_imagepage_suppressborder_bool {
    % store old value of \g_AI_fancy_margins_bool
    \bool_set_eq:NN \l__AI_imagepage_was_border_bool \g_AI_fancy_margins_bool
    % Turn off borders
    \bool_set_false:N \g_AI_fancy_margins_bool
  }

  % Set bg colour instead of bg image if clearcolour is provided
  \tl_if_empty:NTF \l__AI_imagepage_clearcolour_tl {
  } {
    \pagecolor{\l__AI_imagepage_clearcolour_tl}
    \ClearShipoutPictureBG
  }

  \onecolumn
  \vspace*{\fill}
  \begin{center}
    \includegraphics[width=\l__AI_imagepage_imagewidth_tl]{\l__AI_imagepage_image_tl}
  \end{center}
  \vspace*{\fill}
  \twocolumn

  % Restore mode. Does not remember bg image though
  \bool_if:NTF \l__AI_imagepage_was_dark_bool
  { \AIMakeDark }
  { \AIMakeLight }

  % Run after-code
  { #3 }

  % Restore border suppression?
  \bool_if:NT \l__AI_imagepage_suppressborder_bool {
    \bool_set_eq:NN \g_AI_fancy_margins_bool \l__AI_imagepage_was_border_bool
  }
}
