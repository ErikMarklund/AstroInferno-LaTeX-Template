\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Custom headers and footers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\bool_if:NT \l__AI_layout_bool
  {
\RequirePackage {fancyhdr} % Adaptation of the footers

% Setup for custom footer
\pagestyle {fancy}

\cs_if_free:NF \chaptermark
  {
    \renewcommand*{\chaptermark}[1]
      {
        \markboth{}{}
      }
  }

\renewcommand*{\headrulewidth}{0pt} % no rule for header
\renewcommand*{\footrulewidth}{0pt} % no rule for footer

\fancyhf {} % clear all headers and footers

% Left-even page footer
\fancyfoot[LE]{%
    \AIFontFooter \leftmark
    \begin{tikzpicture}[remember~picture,overlay]
      \node[inner~sep=0pt,anchor=south,xshift=.16in,yshift=.13in] at (current~page.south~west) {\AIFontPageNumber \thepage};
    \end{tikzpicture}
  }

% Right-odd page footer
\fancyfoot[RO]{%
    \AIFontFooter \leftmark
    \begin{tikzpicture}[remember~picture,overlay]
      \node[inner~sep=0pt,anchor=south,xshift=-.16in,yshift=.13in] at (current~page.south~east) {\AIFontPageNumber \thepage};
    \end{tikzpicture}
  }

\fancypagestyle {plain} {}

\fancypagestyle{empty}{%
  \fancyfoot{}
}

}
