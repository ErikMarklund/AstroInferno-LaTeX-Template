\ExplSyntaxOn

% Special Columns
\newcolumntype {Y} { > {\centering\arraybackslash } X }
\newcolumntype {`} { > {\global\let\currentrowstyle\relax } }
\newcolumntype {^} { > {\currentrowstyle} }

% Matches {, }, >,  , and any other character
\regex_const:Nn \c__preamble_regex {>\s*{.*}\s*\S|\S}

\newcommand{\rowstyle}[1]
  {
    \gdef\currentrowstyle{#1}#1\ignorespaces
  }

% Used for the stack key below.
\int_new:N \l__AI_table_stack_int

% Table options
\keys_define:nn { astroinferno / table }
  {
    colourodd .tl_set:N            = \l__AI_table_colour_odd_tl,
    colourodd .initial:n           = AItableodd,
    coloureven .tl_set:N            = \l__AI_table_colour_even_tl,
    coloureven .initial:n           = AItableeven,
    header .tl_set:N           = \l__AI_table_header_tl,
    header .value_required:n   = true,
    width .dim_set:N           = \l__AI_table_width_dim,
    width .value_required:n    = true,
    beforespace .bool_set:N        = \l__AI_table_beforespace_bool,
    beforespace .default:n          = true,
    beforespace .initial:n          = true,
    afterspace .bool_set:N        = \l__AI_table_afterspace_bool,
    afterspace .default:n          = true,
    afterspace .initial:n          = true,
    fatfirst .bool_set:N          = \l__AI_table_fatfirst_bool,
    fatfirst .default:n             = true,
    fatfirst .initial:n             = true,
    % stack sets beforespace, afterspace, fatfirst to suit stacked tables.
    stack .choices:nn = {none, single, top, middle, bottom}
    { \int_set:NV \l__AI_table_stack_int {\l_keys_choice_int} },
    stack .initial:n                = none
  }

\tl_new:N \l_use_colour_odd_tl
\tl_new:N \l_use_colour_even_tl
  
% Table Definition
\NewDocumentEnvironment {AITable} { o m }
{
  \group_begin:

  \dim_set:Nn \l__AI_table_width_dim { \linewidth }
  \tl_if_novalue:nF {#1}
    { \keys_set:nn { astroinferno / table } {#1} }

  \int_case:nn {\l__AI_table_stack_int} {
    {1} {} % none. Do nothing
    {2} { % single
      \bool_set_true:N \l__AI_table_beforespace_bool
      \bool_set_true:N \l__AI_table_afterspace_bool
      \bool_set_true:N \l__AI_table_fatfirst_bool
    }
    {3} { % top
      \bool_set_true:N \l__AI_table_beforespace_bool
      \bool_set_false:N \l__AI_table_afterspace_bool
      \bool_set_false:N \l__AI_table_fatfirst_bool
    }
    {4} { % middle
      \bool_set_false:N \l__AI_table_beforespace_bool
      \bool_set_false:N \l__AI_table_afterspace_bool
      \bool_set_false:N \l__AI_table_fatfirst_bool
    }
    {5} { % bottom
      \bool_set_false:N \l__AI_table_beforespace_bool
      \bool_set_true:N \l__AI_table_afterspace_bool
      \bool_set_false:N \l__AI_table_fatfirst_bool
    }
  }

  \par
  \bool_if:NT \l__AI_table_beforespace_bool {\vspace { 9pt plus 3pt minus 3pt }}
  \noindent

  \tl_if_empty:NF \l__AI_table_header_tl
    {
      \group_begin:
        \AIFontTableTitle \l__AI_table_header_tl \nopagebreak
        \par \vspace{ 5pt plus 2pt minus 2pt } \noindent
      \group_end:
    }

  \AIFontTableBody

  % Expand the parameters straight into rowcolors. That allows empty
  % colourodd and coloureven, making transparent rows.
  \exp_args:Neee \rowcolors { 2 } { \l__AI_table_colour_odd_tl } { \l__AI_table_colour_even_tl }

  \regex_extract_all:NnNTF \c__preamble_regex {#2} \l_tmpa_seq
  {
    \tl_set:Nn \l_tmpa_tl {\seq_use:Nn \l_tmpa_seq {^}}
    \use:x { \exp_not:n {\tabularx{\l__AI_table_width_dim}}{`\l_tmpa_tl}}
    \bool_if:NT \l__AI_table_fatfirst_bool {\rowstyle{\AIFontTableHeader}}
  }
  {
    \tabularx {\l__AI_table_width_dim} {2}
  }

}
{
  \endtabularx
  \bool_if:NT \l__AI_table_afterspace_bool {\vspace { 9pt plus 3pt minus 3pt }}

  \group_end:
}
