\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Needed for hack to disable chapter number appearing in TOC title
\bool_new:N \g_AI_isToc_bool
\bool_gset_false:N \g_AI_isToc_bool

\AddToHook{cmd/tableofcontents/before}{ \bool_gset_true:N \g_AI_isToc_bool }
\AddToHook{cmd/tableofcontents/after}{\bool_gset_false:N \g_AI_isToc_bool }
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \l__AI_layout_bool
{
  % Change part numbering to Arabic numbers from Roman numerals
  \renewcommand{\thepart}{\arabic{part}}

  % Set spacing around floats
  \setlength{\textfloatsep}{11pt plus 4pt minus 4pt}
  \setlength{\intextsep}{11pt plus 4pt minus 4pt}
  \setlength{\dbltextfloatsep}{11pt plus 4pt minus 4pt}

  % Remove Numbering (If you want Numbering set secnumdepth to the appropriate depth)
  \setcounter{secnumdepth}{0}

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Section formatting
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Part
  \titleformat {\part}
    [display]
    { \centering \AIFontPart } % format
    { \partname\ \thepart } % label
    { 2ex } % sep
    {} % before-code

  % Chapter
  \NewDocumentCommand{\__AI_FormatChapterTitle}{m}
  {
    \bool_if:NTF {\g_AI_isToc_bool}
    { #1 }
    { #1 \hspace{1mm}\raisebox{36pt}{\normalfont\bfseries\fontsize{24}{28}\selectfont\AIleadzero{\thechapter} } }
  }
  \titleformat {\chapter}
    [ block ]
    { \AIFontChapter \filcenter } % format
    {} % label
    { \wordsep } % sep
    {\__AI_FormatChapterTitle} % before-code
    \titleformat {name=\chapter, numberless}
    [ block ]
    { \AIFontChapter \filcenter } % format
    {} % label
    { \wordsep } % sep
    {} % before-code

  \titlespacing* {\chapter}
    { 0pt }  % left
    { .3ex }  % before-sep
    { 2.8ex } % after-sep

  % Section
  \titleformat {\section}
    { \AIFontSection } % format
    { \thesection } % label
    { 1em } % sep
    { \nopagebreak } % before-code

  \titlespacing* { \section }
    { 0pt } % left
    { 1.3ex plus .43ex minus .43ex } % before-sep
    { 0pt } % after-sep

  % Subsection
  \titleformat {\subsection}
    { \AIFontSubsection } % format
    { \thesubsection } % label
    { 1em } % sep
    { \nopagebreak } % before-code

  \titlespacing*{ \subsection }
    { 0pt } % left
    { 1.4ex plus .47ex minus .47ex } % before-sep
    { 0pt } % after-sep

  % Subsubsection
  \titleformat {\subsubsection}
    { \AIFontSubsubsection } % format
    { \thesubsubsection } % label
    { 1em } % sep
    { \nopagebreak } % before-code

  \titlespacing* { \subsubsection }
    { 0pt } % left
  { 2ex plus .67ex minus .67ex } % before-sep
    { 0pt } % after-sep

  % Paragraph
  \titleformat {\paragraph} [runin]
    { \AIFontParagraph } % format
    { \theparagraph \quad } % label
    {0pt} % sep
    {}    % before-code

  \titlespacing* {\paragraph}
    {0pt}      % left
    {\parskip} % before-sep
    {\wordsep} % after-sep

  % Subparagraph
  \titleformat {\subparagraph} [runin]
    { \AIFontSubaragraph } % format
    { \thesubparagraph \quad } % label
    {0pt} % sep
    {}    % before-code

  \titlespacing* {\subparagraph}
    {\parindent} % left
    {\parskip}   % before-sep
    {\wordsep}   % after-sep
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Special command for magic items, traps, and the like.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NewDocumentCommand {\AIFeatHeader} { m o }
  {
    \subsection {#1}
    \IfValueT{#2}
      {
        \textit {#2}
        \par \vspace{3pt} \noindent \ignorespaces
      }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Special command for magic items, traps, and the like.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NewDocumentCommand {\AIItemHeader} { m m }
  {
    \subsubsection {#1}
    \textit {#2}
    \par \vspace{3pt} \noindent \ignorespaces
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Map Areas and their References
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \l__AI_area_num_depth_tl

% Options
\keys_define:nn { astroinferno / areas }
  {
    area-label .tl_set:N          = \l__AI_area_label_tl,
    area-label .initial:n         = area,
    area-label .value_required:n  = true,
    sub-area-label .tl_set:N          = \l__AI_sub_area_label_tl,
    sub-area-label .initial:n         = subarea,
    sub-area-label .value_required:n  = true,
    region .tl_set:N          = \l__AI_region_tl,
    region .value_required:n  = true,
    area-num-depth .choice:,
    area-num-depth .choices:nn =
      { 1, 2, 3, 4 }
      { \tl_set:Nn \l__AI_area_num_depth_tl {#1} },
    area-num-depth .initial:n  = 2, % subsection
  }

\NewDocumentCommand {\AISetAreaOptions} {o}
  {
    \keys_set:nn { astroinferno / areas } { #1 }
  }

% Counters
\newcounter {AIAreaCounter}

\NewDocumentCommand {\AIResetAreas} {}
  {
    \setcounter {AIAreaCounter} {0}
  }

\newcounter {AISubAreaCounter} [AIAreaCounter]

% sub area references should be '5a', '5b', not '51', '52'
\renewcommand \p@AISubAreaCounter { \arabic {AIAreaCounter} }
\renewcommand \theAISubAreaCounter { \alph {AISubAreaCounter} }

% Functions to create an area including text and label
\NewDocumentCommand {\AIArea} {m}
  {
    \refstepcounter {AIAreaCounter}
    \label { \l__AI_region_tl \l__AI_area_label_tl :#1 }

    \tl_set:Nn \l_tmpa_tl { \l__AI_region_tl \arabic {AIAreaCounter} . ~ #1 }

    \str_case_e:nn {\l__AI_area_num_depth_tl}
      {
        {1} { \section       {\l_tmpa_tl} }
        {2} { \subsection    {\l_tmpa_tl} }
        {3} { \subsubsection {\l_tmpa_tl} }
        {4} { \paragraph     {\l_tmpa_tl} }
      }
  }

\NewDocumentCommand {\AISubArea} {m}
  {
    \refstepcounter {AISubAreaCounter}
    \label { \l__AI_region_tl \l__AI_sub_area_label_tl : #1 }

    \tl_set:Nn \l_tmpa_tl { \l__AI_region_tl \arabic {AIAreaCounter} \alph {AISubAreaCounter} . ~ #1 }

    \str_case_e:nn {\l__AI_area_num_depth_tl}
      {
        {1} { \subsection    {\l_tmpa_tl} }
        {2} { \subsubsection {\l_tmpa_tl} }
        {3} { \paragraph     {\l_tmpa_tl} }
        {4} { \subparagraph  {\l_tmpa_tl} }
      }

  }

% Functions to reference a label
\NewDocumentCommand {\AIAreaRef} { o m }
  {
    \group_begin:
      \keys_set:nn { astroinferno / areas } {#1} % Temp set keys to reference other regions
      #2 ~ ( \pageabbreviationname\ \pageref { \l__AI_region_tl \l__AI_area_label_tl : #2 } )
    \group_end:
  }

\NewDocumentCommand {\AISubAreaRef} { o m }
  {
    \group_begin:
      \keys_set:nn { astroinferno / areas } { #1 } % Temp set keys to reference other regions
      #2 ~ ( \pageabbreviationname\ \pageref { \l__AI_region_tl \l__AI_sub_area_label_tl : #2 } )
    \group_end:
  }

% Definition of iparagraph, an italized paragraph
\NewDocumentCommand{\iparagraph}{m}{\paragraph{\textit{#1}}}
\NewDocumentCommand{\subiparagraph}{m}{\subparagraph{\textit{#1}}}