\ExplSyntaxOn


% Adds a boxstyle to sidebars
\NewDocumentCommand\AISidebarAddBoxstyle{m}
{ \tcbset{ AI_sidebar_extra/.append~style={#1} } }

% Clears all boxstyles from sidebars
\NewDocumentCommand\AISidebarClearBoxstyle{}
{ \tcbset{ AI_sidebar_extra/.style={} } }

% Revert to default. Sidebars use pointy banner.
\NewDocumentCommand\AISidebarDefaultBoxstyle{}
{
  \AISidebarClearBoxstyle
  \AISidebarAddBoxstyle{AIboxstylePointyBanner}
}

% Initialise
\AISidebarDefaultBoxstyle

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Environment for sidebars.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Make a sidebar base style
\tcbset{
  AI_sidebar_base/.style = {
    before~upper     =
    {
      \bool_if:NT \l__AI_layout_bool
      {
        \bool_if:NF \l__AI_justified_bool
        {\RaggedRight}
      }
    },
    code={\linespread{.9}},
    frame~hidden,
    boxrule          = 0pt,
    enhanced,
    before~skip      = 13pt plus 4pt minus 4pt,
    toptitle         = 2pt,
    boxsep           = 3pt,
    left             = 6pt,
    right            = 6pt,
    top              = 0pt,
    bottom           = 0pt,
    valign           = center,
    fonttitle        = \AIFontSidebarTitle,
    fontupper        = \AIFontSidebarBody,
    fontlower        = \AIFontSidebarBody,
    sharp~corners,
    parbox           = false,
    coltitle         = black,
    after~skip       = 14pt plus 4pt minus 4pt,
  }
}

\DeclareTColorBox {__AI_sidebar} {o}
  {
    AI_sidebar_base,
    AI_sidebar_extra,
    #1,
  }

% Extra key for controlling the colour of the title and the background
\keys_define:nn { astroinferno / sidebar }
  {
    colour .tl_set:N         = \l__AI_sidebar_colour_tl,
    colour .initial:n        = sidebarcolour,
    colour .value_required:n = true,
  }

% This function, through its variant, forces the expansion of the tcb keys
% passed to the environment by the user before it invokes the tcolorbox
\cs_new_protected:Nn \__AI_start_sidebar:nn
  {
    \begin {__AI_sidebar} [ #1, #2 ]
  }

\cs_generate_variant:Nn \__AI_start_sidebar:nn { nV }

% The AISidebar environment
% #1 - keys. We handle the custom colour key before passing other keys on
% #2 - title.
\NewDocumentEnvironment {AISidebar} { o m }
  {
    \group_begin:
    \tl_clear:N \l_tmpa_tl
      \tl_if_novalue:nF {#1}
        { \keys_set_known:nnN { astroinferno / sidebar } {#1} \l_tmpa_tl }

      \__AI_start_sidebar:nV
        {
          colback      = \l__AI_sidebar_colour_tl,
          colbacktitle = \l__AI_sidebar_colour_tl,
          title        = {#2},
        }
        \l_tmpa_tl
    }


  {
    \end {__AI_sidebar}
    \group_end:
  }
