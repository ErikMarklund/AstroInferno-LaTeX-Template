\ExplSyntaxOn

\bool_if:NT \l__AI_layout_bool
{
  \RequirePackage{titletoc}

  % Makes the TOC go to section depth
  \setcounter{tocdepth}{1}

  \titlecontents{part}
    [0pt] % left
    { \addvspace{.06in} \AIFontTocPart } % above-code
    {\partname\ \thecontentslabel :~ } % numbered-entry-format
    {} % numberless-entry-format
    {} % filler-page-format
    [ \addvspace{-.03in} \titleline{ \color{AIdeepred} \titlerule[1pt] } \addvspace{.05in } ] % below-code

  \titlecontents{chapter}
    [0pt] % left
    { \addvspace{.1in} \AIFontTocChapter } % above-code
    { \makebox[1cm][l]{\AIleadzero{\thecontentslabel}} } % numbered-entry-format
    { \hspace*{1cm}} % numberless-entry-format
    {\titlerule*{}\contentspage[\itshape\AIquoteFont\thecontentspage]} % filler-page-format

  \titlecontents{section}
    [1cm] % left
    {\AIFontTocSection} % above-code
    {} % numbered-entry-format
    {} % numberless-entry-format
    {\titlerule*{}\contentspage[\itshape\AIquoteFont\thecontentspage]} % filler-page-format

  \newcommand\tocchapapp{\tocchapterabbreviationname}
  \g@addto@macro\appendix{%
    \addtocontents{toc}{\protect\renewcommand{\protect\@chapapp}{\appendixname}}%
    \addtocontents{toc}{\protect\renewcommand{\protect\tocchapapp}{\appendixname}}%
  }
}
