% ==== Mortality symbol (tombstone)
\newcommand{\AImortalitysymboltikz}{
  \begin{tikzpicture}[
    % Set (0,0) as the true typographical baseline floor. 
    % The top of the capsule base aligns exactly with the bottom of letters.
    baseline={(0,0)}, 
    scale=1.0, 
    every~path/.style={line~join=round}
  ]
    % A single, clean fill command using the even-odd subtraction rule.
    % The cross center stays completely hollow and its inner corners stay perfectly sharp.
    \fill[fill=., even~odd~rule]
      % Base (Height = 0.11em, Tuned Width = 0.88em)
      [rounded~corners=0.025em] (-0.44em, -0.11em) rectangle (0.44em, 0.0em)
      
      % Actual tombstone (Total Width = 0.66em, Peak Height = 0.74em)
      [rounded~corners=0em] (-0.33em, 0.05em) -- (-0.33em, 0.41em) 
      arc (180\:0\:0.33em) -- (0.33em, 0.05em) -- cycle
      
      % Cross
      (-0.04em, 0.48em) -- 
      (-0.136em, 0.48em) arc (90\:180\:0.024em) -- 
      (-0.160em, 0.424em) arc (180\:270\:0.024em) -- 
      (-0.04em, 0.40em) -- 
      (-0.04em, 0.184em) arc (180\:270\:0.024em) -- 
      (0.016em,  0.160em) arc (270\:360\:0.024em) -- 
      (0.04em,  0.40em) -- 
      (0.136em,  0.40em) arc (270\:360\:0.024em) -- 
      (0.160em,  0.456em) arc (0\:90\:0.024em) -- 
      (0.04em,  0.48em) -- 
      (0.04em,  0.566em) arc (0\:90\:0.024em) -- 
      (-0.016em, 0.590em) arc (90\:180\:0.024em) -- cycle;

  \end{tikzpicture}
}


