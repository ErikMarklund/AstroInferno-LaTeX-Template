\ExplSyntaxOn

% tikz expects ':' but \ExplSyntaxOn messes with spaces and ':'.
% Need to insert the colon in another way using \c_colon_str and the local variable defined below.
% Spaces are solved with ~.
\tl_set_eq:NN \: \c_colon_str


