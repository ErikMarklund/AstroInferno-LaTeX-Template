% ==== Ancient symbol (Hamsa; not awesome)
\newcommand{\AIancienttikzsymbol}{
  \begin{tikzpicture}[
    % Set (0,0) as the true typographical baseline floor.
    % Perfect Sync: Bottom sits exactly at Y = -0.11em, Top peaks exactly at Y = 0.74em.
    baseline={(0,0)}, 
    scale=1.0, 
    every~path/.style={line~join=round}
  ]
    \fill[fill=., even~odd~rule]
      % Outer
      % Start at the left outer finger base wall (X = -0.25em, Y = 0.28em)
      (-0.25em, 0.28em) -- 
      % Left Finger Column (Capsule top peaking at Y = 0.64em)
      (-0.25em, 0.58em) arc (180\:0\:0.06em) -- 
      % Left Index Gap Floor (Shortened vertically, then sweeping into a 0.024em arc)
      (-0.13em, 0.404em) arc (180\:270\:0.024em) --
      % Middle Finger Left Wall (Sweeping smoothly back up into the center column)
      (-0.089em, 0.380em) arc (270\:360\:0.024em) -- 
      % Middle Finger Main Column (Capsule top peaking at Y = 0.74em)
      (-0.065em, 0.675em) arc (180\:0\:0.065em) -- 
      % Middle Finger Right Wall (Dropping down into the right valley)
      (0.065em, 0.404em) arc (180\:270\:0.024em) --
      % Right Index Gap Floor (Sweeping smoothly back up into the right column)
      (0.106em, 0.380em) arc (270\:360\:0.024em) --
      % Right Finger Column (Capsule top peaking at Y = 0.64em)
      (0.13em, 0.58em) arc (180\:0\:0.06em) -- 
      % Right Outer Finger Base Wall
      (0.25em, 0.28em) --
      % Right Outer Thumb Step
      (0.35em, 0.28em) 
      % Rounded Right Thumb Tip Flare (Smooth continuous 180-degree sweep)
      arc (90\:-90\:0.06em)
      % Straight 45-degree angle line sloping down inwardly from the thumb floor tangent
      -- (0.1366em, -0.0534em)
      % Mathematically locked connecting arc (Radius: 0.19315em, Centered exactly at X=0)
      arc (315\:225\:0.19315em)
      % Symmetrical straight 45-degree angle line rising up to the left thumb floor tangent
      -- (-0.35em, 0.16em)
      % Rounded Left Thumb Tip Flare (Smooth continuous 180-degree sweep)
      arc (270\:180\:0.06em)
      arc (180\:90\:0.06em) -- (-0.35em, 0.28em) -- cycle

      % Eye cut out
      (-0.16em, 0.15em) arc (210\:330\:0.1848em)
                        arc (30\:150\:0.1848em) -- cycle

      % Pupil
      (0.0em, 0.11em) arc (-90\:270\:0.04em) -- cycle;

  \end{tikzpicture}
}


