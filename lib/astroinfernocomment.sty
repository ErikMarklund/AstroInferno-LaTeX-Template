\ExplSyntaxOn


% Adds a boxstyle to comments
\NewDocumentCommand\AICommentAddBoxstyle{m}
{ \tcbset{ AI_comment_extra/.append~style={#1} } }

% Clears all boxstyles from comments
\NewDocumentCommand\AICommentClearBoxstyle{}
{ \tcbset{ AI_comment_extra/.style={} } }

% Revert to dafault. Comments use a plain style.
\NewDocumentCommand\AICommentDefaultBoxstyle{}
{ \AICommentClearBoxstyle }

% Initialise
\AICommentDefaultBoxstyle

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Environment for comments.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Make a comment base style
\tcbset{
  AI_comment_base/.style = {
    before~upper =
    {
      \bool_if:NT \l__AI_layout_bool
      {
        \bool_if:NF \l__AI_justified_bool
        { \RaggedRight }
      }
    },
    code         = {\linespread{.9}},
    frame~hidden,
    boxrule      = 0pt,
    breakable,
    enhanced~jigsaw,
    before~skip  = 13pt plus 4pt minus 4pt,
    toptitle     = 2pt,
    boxsep       = 3pt,
    left         = 6pt,
    right        = 6pt,
    top          = 0pt,
    bottom       = 2pt,
    sharp~corners,
    fonttitle    = \AIFontCommentTitle,
    fontupper    = \AIFontCommentBody,
    fontlower    = \AIFontCommentBody,
    parbox       = false,
    coltitle     = black,
    after~skip   = 13pt plus 4pt minus 4pt,
  }
}

% Standard for every comment
\DeclareTColorBox {__AI_comment} {o}
  {
    AI_comment_base,
    AI_comment_extra,
    #1,
  }

% Extra key for controlling the colour of the title and the background
\keys_define:nn { astroinferno / comment }
  {
    colour .tl_set:N         = \l__AI_comment_colour_tl,
    colour .initial:n        = commentcolour,
    colour .value_required:n = true,
  }

% This function, through its variant, forces the expansion of the tcb keys
% passed to the environment by the user before it invokes the tcolorbox
\cs_new_protected:Nn \__AI_start_comment:nn
  {
    \begin {__AI_comment} [ #1, #2 ]
  }

\cs_generate_variant:Nn \__AI_start_comment:nn { nV }

% The AIComment environment
% #1 - keys. We handle the custom colour key before passing other keys on
% #2 - title.
\NewDocumentEnvironment {AIComment} { o m }
  {
    \group_begin:
    \tl_clear:N \l_tmpa_tl
    \tl_if_novalue:nF {#1}
    { \keys_set_known:nnN { astroinferno / comment } {#1} \l_tmpa_tl }

    \__AI_start_comment:nV
      {
          colback      = \l__AI_comment_colour_tl,
          colbacktitle = \l__AI_comment_colour_tl,
          title        = {#2},
      }
      \l_tmpa_tl
  }
  {
    \end {__AI_comment}
    \group_end:
  }
